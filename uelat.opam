opam-version: "2.0"
name: "uelat"
version: "dev"
synopsis: "Certificate-carrying approximation — v3 formalization (Rocq)"
description: """
Formal artifacts accompanying arXiv:2506.22693 v3
(Ballús Santacana, "Universal Gluing and Contextual Choice:
 Certificate-Carrying Approximation, Functorial Evidence, and Effective
 Descent"). See README.md and docs/FORMALIZATION_STATUS.md.
"""
maintainer: "andreu.ballus@uab.cat"
authors: [ "Andreu Ballús Santacana" ]
homepage: "https://github.com/ipsissima/UELAT"
bug-reports: "https://github.com/ipsissima/UELAT/issues"
license: "MIT"
depends: [
  # Lower bounds match what the current CI resolves and builds green
  # on (see docs/BUILD_NOTES.md). Upper bounds are DELIBERATELY not
  # pinned here: opam-repo add / restore-cache interactions in CI plus
  # cross-package dependency solving make tight upper bounds brittle,
  # and a lockfile (opam.export or similar) is the honest way to
  # freeze exact versions. Follow-up: add such a lockfile and drop
  # this comment. Until then, the reproducibility claim in
  # docs/FORMALIZATION_STATUS.md rests on the CI job resolving the
  # same versions run-to-run, not on lower-bound pins.
  "ocaml"                    {>= "4.14.2"}
  "rocq-prover"              {>= "9.0.0"}
  "coq-mathcomp-ssreflect"
  "coq-mathcomp-algebra"
  "coq-mathcomp-analysis"
  "dune"                     {>= "3.10.0"}
]
build: [ "dune" "build" "-p" "uelat" "-j" jobs ]
install: [ "dune" "install" "-p" "uelat" ]
